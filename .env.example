# Flask Configuration
FLASK_APP=app.py
FLASK_DEBUG=false
SECRET_KEY=cambodia-hrms-secret-key-change-this-in-production

# Port (Defaults to 5000)
PORT=5000

# Database URL (Leave blank to use SQLite, or set PostgreSQL URI for production)
# Example: postgresql://user:password@localhost:5432/hrms_db
DATABASE_URL=sqlite:///hrms.db
